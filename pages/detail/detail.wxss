.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* ========== 浏览模式导航 ========== */
.browse-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.browse-prev, .browse-next {
  font-size: 28rpx;
  color: #5B8DEF;
  font-weight: 600;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  background: #EEF3FF;
}

.browse-prev:active, .browse-next:active {
  opacity: 0.7;
}

.browse-disabled {
  opacity: 0.3;
}

.browse-progress {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.browse-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #5B8DEF;
}

.browse-divider {
  font-size: 28rpx;
  color: #ccc;
}

.browse-total {
  font-size: 28rpx;
  color: #999;
}

.card-main {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-body {
  padding: 36rpx;
}

/* 卡片横幅配图 */
.card-banner {
  width: 100%;
  height: 350rpx;
  display: block;
}

/* 单词头部 */
.word-header {
  text-align: center;
  margin-bottom: 36rpx;
  padding-bottom: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.word-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.word-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #2C3E50;
}

.word-actions {
  display: flex;
  gap: 12rpx;
  font-size: 36rpx;
}

.word-meta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.word-phonetic {
  font-size: 28rpx;
  color: #aaa;
}

.word-pos {
  font-size: 24rpx;
  color: #5B8DEF;
  background: #EEF3FF;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.word-stars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.stars {
  color: #F1C40F;
  font-size: 24rpx;
}

.freq-label {
  font-size: 22rpx;
  color: #999;
}

/* 内联播放按钮（单词旁） */
.play-btn {
  font-size: 32rpx;
  cursor: pointer;
  transition: transform 0.2s;
}

.play-btn:active {
  transform: scale(1.2);
}

/* 内联播放按钮（例句标签旁） */
.play-inline {
  font-size: 28rpx;
  cursor: pointer;
  transition: transform 0.2s;
}

.play-inline:active {
  transform: scale(1.2);
}

/* 释义 */
.section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cn-mean {
  font-size: 36rpx;
  color: #E67E22;
  font-weight: 500;
  display: block;
  margin-bottom: 10rpx;
}

.en-mean {
  font-size: 24rpx;
  color: #888;
}

/* 例句 */
.example-box {
  border-radius: 12rpx;
  padding: 20rpx;
}

.example-box.orange {
  background: #FFF8F0;
  border-left: 6rpx solid #E67E22;
}

.example-box.blue {
  background: #F0F4FF;
  border-left: 6rpx solid #5B8DEF;
}

.example-en {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.6;
}

.example-cn {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

.example-scene {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 8rpx;
  padding-left: 8rpx;
}

/* 小知识 */
.tip-section {
  background: #FFFEF5;
  border-radius: 16rpx;
  padding: 20rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #8B6914;
  line-height: 1.6;
}

/* 底部固定按钮 */
.next-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.next-text {
  flex: 1;
  text-align: center;
  background: linear-gradient(135deg, #5B8DEF, #7C6FF7);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 16rpx;
}

.next-text:active {
  opacity: 0.85;
}

.next-progress {
  font-size: 24rpx;
  color: #5B8DEF;
  background: #EEF3FF;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

/* 来源 */
.source-bar {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

/* tag */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.tag-orange {
  background: #FFF3E8;
  color: #E67E22;
}

.tag-blue {
  background: #EEF3FF;
  color: #5B8DEF;
}

.tag-green {
  background: #E8F8E8;
  color: #27AE60;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #5B8DEF, #7C6FF7);
  color: #fff;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}
