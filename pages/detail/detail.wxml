<!-- 单词卡片详情 -->
<view class="container" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <view class="card-main" bindtap="onTapCard">
    <!-- 单词配图 -->
    <image class="card-banner" src="{{imageSrc}}" mode="aspectFill" binderror="onImageError"></image>

    <view class="card-body">
      <!-- 单词头部 -->
      <view class="word-header">
        <view class="word-row">
          <text class="word-text">{{word.word}}</text>
          <text class="play-btn" catchtap="onPlayWord">🔊</text>
        </view>
        <view class="word-meta-row">
          <text class="word-phonetic">{{word.phonetic}}</text>
          <text class="word-pos" wx:if="{{word.pos}}">{{word.pos}}</text>
          <text class="key-badge" wx:if="{{word.key}}">重点</text>
        </view>
        <view class="word-stars">
          <text class="stars">{{stars}}</text>
          <text class="freq-label">{{freqLabel}}</text>
        </view>
      </view>

      <!-- 释义 -->
      <view class="section">
        <view class="section-label">释义</view>
        <text class="cn-mean">{{word.cnMeaning}}</text>
        <text class="en-mean" wx:if="{{word.enMeaning}}">{{word.enMeaning}}</text>
      </view>

      <!-- 拓展例句 -->
      <view class="section" wx:if="{{extraExample}}">
        <view class="section-label">
          <text class="tag tag-blue">拓展例句</text>
          <text class="play-inline" catchtap="onPlayExtra">🔊</text>
        </view>
        <view class="example-box blue">
          <text class="example-en">{{extraExample}}</text>
          <text class="example-cn">{{extraCn}}</text>
        </view>
      </view>

      <!-- 小知识 -->
      <view class="section tip-section" wx:if="{{tip}}">
        <view class="section-label">
          <text class="tag tag-green">考点小知识</text>
        </view>
        <text class="tip-text">{{tip}}</text>
      </view>

      <!-- 来源 -->
      <view class="source-bar">
        <text>{{word.module}} · {{word.origin || '外研版2026秋季版 九（上）'}}</text>
      </view>
    </view>
  </view>

  <!-- 底部：浏览模式导航 -->
  <view class="browse-bar" wx:if="{{isBrowse}}">
    <view class="browse-prev {{browseIndex > 0 || hasPrevUnit ? '' : 'browse-disabled'}}" bindtap="onPrevWord">
      {{hasPrevUnit ? '‹ 上一单元' : '‹ 上一个'}}
    </view>
    <view class="browse-progress">
      <text class="browse-num">{{browseIndex + 1}}</text>
      <text class="browse-divider">/</text>
      <text class="browse-total">{{browseTotal}}</text>
    </view>
    <view class="browse-next {{browseIndex < browseTotal - 1 || hasNextUnit ? '' : 'browse-disabled'}}" bindtap="onNextWord">
      {{hasNextUnit ? '下一单元 ›' : '下一个 ›'}}
    </view>
  </view>


</view>
