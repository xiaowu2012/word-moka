<!-- 教材学习中心 -->
<view class="container">
  <!-- 顶部 -->
  <view class="header">
    <view class="header-top">
      <view class="header-left" bindtap="onBack">
        <text class="back-arrow">‹</text>
      </view>
      <view class="header-info">
        <text class="header-icon">{{textbook.cover}}</text>
        <text class="header-name">{{textbook.name}}</text>
      </view>
      <view class="header-right"></view>
    </view>
    <image class="header-illust" src="/images/study-banner.jpg" mode="aspectFill"></image>
  </view>

  <!-- 进度卡片 -->
  <view class="progress-card">
    <view class="progress-header">
      <text class="progress-title">学习进度</text>
      <text class="progress-sub">{{learnedCount}} / {{totalWords}} 词</text>
    </view>
    <view class="progress-bar-wrap">
      <view class="progress-fill" style="width: {{totalWords > 0 ? (learnedCount / totalWords * 100) : 0}}%"></view>
    </view>
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{learnedCount}}</text>
        <text class="stat-label">已掌握</text>
      </view>
      <view class="stat-item">
        <text class="stat-num due-num">{{dueCount}}</text>
        <text class="stat-label">今日待复习</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{totalWords - learnedCount}}</text>
        <text class="stat-label">待学习</text>
      </view>
    </view>
  </view>

  <!-- 操作区 -->
  <view class="action-section">
    <view class="action-card learn-card" bindtap="onContinueLearning">
      <text class="action-icon book-icon">📖</text>
      <view class="action-info">
        <text class="action-title">继续学习</text>
        <text class="action-desc">学一个新单词</text>
      </view>
      <text class="action-arrow">›</text>
    </view>

    <view class="action-card review-card {{dueCount > 0 ? '' : 'muted'}}" bindtap="onStartReview">
      <text class="action-icon review-icon">🔄</text>
      <view class="action-info">
        <text class="action-title">今日复习</text>
        <text class="action-desc">{{dueCount > 0 ? dueCount + ' 个单词待复习' : '今天没有待复习的单词'}}</text>
      </view>
      <text class="action-badge" wx:if="{{dueCount > 0}}">{{dueCount}}</text>
      <text class="action-arrow">›</text>
    </view>

    <view class="action-card list-card" bindtap="onViewWordList">
      <text class="action-icon list-icon">📝</text>
      <view class="action-info">
        <text class="action-title">单词列表</text>
        <text class="action-desc">浏览全部 {{totalWords}} 个单词</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
  </view>
</view>
