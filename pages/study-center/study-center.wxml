<!-- 教材学习中心 -->
<view class="container">
  <!-- 顶部 -->
  <view class="header">
    <view class="header-top">
      <view class="header-left" bindtap="onBack">
        <text class="back-arrow">‹</text>
      </view>
      <view class="header-info">
        <text class="header-icon">{{textbook.cover}}</text>
        <text class="header-name">{{textbook.name}}</text>
      </view>
      <view class="header-right"></view>
    </view>
  </view>

  <!-- 进度卡片 -->
  <view class="progress-card">
    <view class="progress-header">
      <text class="progress-title">学习进度</text>
      <text class="progress-sub">{{learnedCount}} / {{totalWords}} 词</text>
    </view>
    <view class="progress-bar-wrap">
      <view class="progress-fill" style="width: {{totalWords > 0 ? (learnedCount / totalWords * 100) : 0}}%"></view>
    </view>
  </view>

  <!-- 每日目标卡片 -->
  <view class="goal-card">
    <view class="goal-header">
      <text class="goal-title">📅 今日学习</text>
      <view class="goal-setter" bindtap="onGoalTap">
        <text class="goal-label">每日目标</text>
        <text class="goal-value">{{dailyGoal}} 词</text>
        <text class="goal-arrow">▾</text>
      </view>
    </view>
    <view class="goal-progress-wrap">
      <view class="goal-fill" style="width: {{dailyGoal > 0 ? Math.min(todayLearned / dailyGoal * 100, 100) : 0}}%"></view>
    </view>
    <view class="goal-stats">
      <text class="goal-count">已学 <text class="goal-num">{{todayLearned}}</text></text>
      <text class="goal-count">剩余 <text class="goal-num {{dailyGoal - todayLearned > 0 ? '' : 'goal-done'}}">{{Math.max(dailyGoal - todayLearned, 0)}}</text></text>
    </view>
  </view>

  <!-- 目标选择浮层 -->
  <view class="goal-mask" wx:if="{{showGoalPicker}}" bindtap="onGoalPickerClose"></view>
  <view class="goal-picker" wx:if="{{showGoalPicker}}">
    <text class="picker-title">每日学习目标</text>
    <view class="picker-options">
      <view 
        class="picker-option {{goal === dailyGoal ? 'selected' : ''}}"
        wx:for="{{goalOptions}}"
        wx:key="*this"
        bindtap="onGoalSelect"
        data-goal="{{item}}"
      >
        <text class="option-value">{{item}}</text>
        <text class="option-label">个单词</text>
        <text class="option-check" wx:if="{{item === dailyGoal}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 操作区 -->
  <view class="action-section">
    <view class="action-card learn-card {{todayLearned >= dailyGoal ? 'done' : ''}}" bindtap="onContinueLearning">
      <text class="action-icon book-icon">{{todayLearned >= dailyGoal ? '🎉' : '📖'}}</text>
      <view class="action-info">
        <text class="action-title">{{todayLearned >= dailyGoal ? '今日目标完成' : '继续学习'}}</text>
        <text class="action-desc">{{todayLearned >= dailyGoal ? '真棒！明天再来～' : '自动安排下一个新单词'}}</text>
      </view>
      <text class="action-arrow">›</text>
    </view>

    <view class="action-card review-card {{dueCount > 0 ? '' : 'muted'}}" bindtap="onStartReview">
      <text class="action-icon review-icon">🔄</text>
      <view class="action-info">
        <text class="action-title">今日复习</text>
        <text class="action-desc">{{dueCount > 0 ? dueCount + ' 个单词待复习' : '今天没有待复习的单词'}}</text>
      </view>
      <text class="action-badge" wx:if="{{dueCount > 0}}">{{dueCount}}</text>
      <text class="action-arrow">›</text>
    </view>

    <view class="action-card list-card" bindtap="onViewWordList">
      <text class="action-icon list-icon">📝</text>
      <view class="action-info">
        <text class="action-title">单词列表</text>
        <text class="action-desc">浏览全部 {{totalWords}} 个单词</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
  </view>
</view>
