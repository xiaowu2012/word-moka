<!-- 教材学习中心 -->
<view class="container">
  <!-- 顶部教材封面 -->
  <view class="textbook-cover">
    <image class="cover-image" src="/images/textbook-cover.jpg" mode="widthFix"></image>
    <text class="cover-name">{{textbook.name}}</text>
    <text class="cover-count">{{totalWords}}个单词</text>
  </view>

  <!-- 进度 + 每日目标（合并） -->
  <view class="stats-card">
    <view class="stat-row">
      <view class="stat-label-row">
        <text class="stat-label">学习中</text>
        <text class="stat-pct">{{totalWords > 0 ? Math.round(learnedCount / totalWords * 100) : 0}}%</text>
      </view>
      <text class="stat-value">{{learnedCount}} / {{totalWords}}</text>
    </view>
    <view class="bar-wrap">
      <view class="bar-fill blue" style="width: {{totalWords > 0 ? (learnedCount / totalWords * 100) : 0}}%"></view>
    </view>

    <view class="stat-row" style="margin-top: 20rpx;">
      <view class="stat-label-row">
        <text class="stat-label">今日学习</text>
        <text class="stat-pct">{{dailyGoal > 0 ? Math.round(todayLearned / dailyGoal * 100) : 0}}%</text>
      </view>
      <view class="stat-right">
        <text class="stat-mini">{{todayLearned}} / {{dailyGoal}}</text>
        <view class="goal-setter" bindtap="onGoalTap">
          <text class="goal-arrow">▾ {{dailyGoal}}词</text>
        </view>
      </view>
    </view>
    <view class="bar-wrap">
      <view class="bar-fill green" style="width: {{dailyGoal > 0 ? Math.min(todayLearned / dailyGoal * 100, 100) : 0}}%"></view>
    </view>
  </view>

  <!-- 操作区 -->
  <view class="action-section">
    <view class="action-card learn-card {{todayLearned >= dailyGoal ? 'done' : ''}}" bindtap="onContinueLearning">
      <text class="action-icon">{{todayLearned >= dailyGoal ? '🎉' : '📖'}}</text>
      <view class="action-info">
        <text class="action-title">{{todayLearned >= dailyGoal ? '今日目标完成' : '继续学习'}}</text>
        <text class="action-desc">{{todayLearned >= dailyGoal ? '明天继续加油！' : '自动安排一个新单词'}}</text>
      </view>
      <text class="action-arrow">›</text>
    </view>

    <view class="action-card review-card {{dueCount > 0 ? '' : 'muted'}}" bindtap="onStartReview">
      <text class="action-icon">🔄</text>
      <view class="action-info">
        <text class="action-title">今日复习</text>
        <text class="action-desc">{{dueCount > 0 ? dueCount + ' 个单词待复习' : '暂无待复习单词'}}</text>
      </view>
      <text class="action-badge orange" wx:if="{{dueCount > 0}}">{{dueCount}}</text>
      <text class="action-arrow">›</text>
    </view>

    <view class="action-card list-card" bindtap="onViewWordList">
      <text class="action-icon">📝</text>
      <view class="action-info">
        <text class="action-title">单词列表</text>
        <text class="action-desc">浏览全部 {{totalWords}} 个单词</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <!-- 目标选择浮层 -->
  <view class="goal-mask" wx:if="{{showGoalPicker}}" bindtap="onGoalPickerClose"></view>
  <view class="goal-picker" wx:if="{{showGoalPicker}}">
    <text class="picker-title">每日学习目标</text>
    <view class="picker-options">
      <view 
        class="picker-option {{goal === dailyGoal ? 'selected' : ''}}"
        wx:for="{{goalOptions}}" wx:key="*this"
        bindtap="onGoalSelect" data-goal="{{item}}"
      >
        <text class="option-value">{{item}}</text>
        <text class="option-label">个单词</text>
        <text class="option-check" wx:if="{{item === dailyGoal}}">✓</text>
      </view>
    </view>
  </view>
</view>
