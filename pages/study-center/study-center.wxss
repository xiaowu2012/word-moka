.container {
  background: #F5F7FA;
  min-height: 100vh;
}

/* 顶部 */
.header {
  background: linear-gradient(180deg, #5B8DEF 0%, #7C6FF7 100%);
  padding-bottom: 60rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 0;
}

.header-left,
.header-right {
  width: 60rpx;
}

.back-arrow {
  font-size: 52rpx;
  color: #fff;
  font-weight: 300;
}

.header-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-icon {
  font-size: 40rpx;
}

.header-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.header-illust {
  width: 100%;
  height: 200rpx;
  margin-top: 24rpx;
  opacity: 0.3;
  mix-blend-mode: overlay;
}

/* 进度卡片 */
.progress-card {
  margin: -40rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
}

.progress-sub {
  font-size: 24rpx;
  color: #999;
}

.progress-bar-wrap {
  height: 10rpx;
  background: #e8e8e8;
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B8DEF, #7C6FF7);
  border-radius: 5rpx;
  transition: width 0.3s;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #5B8DEF;
}

.due-num {
  color: #E74C3C;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 操作区 */
.action-section {
  padding: 0 24rpx 40rpx;
}

.action-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.action-card:active {
  transform: scale(0.98);
  transition: transform 0.1s;
}

.action-card.muted {
  opacity: 0.6;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.book-icon {
  background: #EEF3FF;
}

.review-icon {
  background: #FFF0F0;
}

.list-icon {
  background: #E8F8E8;
}

.action-info {
  flex: 1;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 24rpx;
  color: #999;
}

.action-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.action-badge {
  background: #E74C3C;
  color: #fff;
  font-size: 22rpx;
  min-width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  margin-left: 8rpx;
}
