.container {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部教材封面 */
.textbook-cover {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx;
  background: linear-gradient(180deg, #5B8DEF 0%, #7C6FF7 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.cover-image {
  width: 300rpx;
  height: 420rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
  margin-bottom: 16rpx;
}

.cover-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.cover-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 统计卡片（合并进度+目标） */
.stats-card {
  margin: -24rpx 24rpx 16rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #5B8DEF;
}

.stat-pct {
  font-size: 22rpx;
  color: #aaa;
  font-weight: 400;
  margin-left: 8rpx;
}

.stat-label-row {
  display: flex;
  align-items: baseline;
}

.stat-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-mini {
  font-size: 28rpx;
  font-weight: 700;
  color: #27AE60;
}

.goal-setter {
  background: #F0F4FF;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
}

.goal-setter:active {
  opacity: 0.7;
}

.goal-arrow {
  font-size: 24rpx;
  color: #5B8DEF;
}

.bar-wrap {
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 4rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.bar-fill.blue {
  background: linear-gradient(90deg, #5B8DEF, #7C6FF7);
}

.bar-fill.green {
  background: linear-gradient(90deg, #27AE60, #2ECC71);
}

/* 操作区 */
.action-section {
  padding: 0 24rpx;
}

.action-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.action-card:active {
  transform: scale(0.98);
  transition: transform 0.1s;
}

.action-card.muted {
  opacity: 0.55;
}

.action-card.done {
  background: #E8F8E8;
}

.action-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 56rpx;
  text-align: center;
  flex-shrink: 0;
}

.action-info {
  flex: 1;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 10rpx;
}

.action-desc {
  font-size: 24rpx;
  color: #999;
}

.action-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.action-badge {
  font-size: 22rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  margin-left: 8rpx;
}

.action-badge.orange {
  background: #FFF0F0;
  color: #E74C3C;
}

/* 模块下拉框 */
.module-picker-row {
  padding: 0 24rpx 16rpx;
}

.module-picker {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.module-picker:active {
  opacity: 0.7;
}

.picker-label {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.picker-value {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
}

.picker-arrow {
  font-size: 24rpx;
  color: #ccc;
  margin-left: 8rpx;
}

/* 目标选择浮层 */
.goal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 99;
}

.goal-picker {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  width: 520rpx;
  z-index: 100;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E50;
  text-align: center;
  display: block;
  margin-bottom: 24rpx;
}

.picker-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.picker-option {
  display: flex;
  align-items: center;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 24rpx;
}

.picker-option:active {
  transform: scale(0.97);
}

.picker-option.selected {
  background: #EEF3FF;
  border: 2rpx solid #5B8DEF;
}

.option-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E50;
  min-width: 50rpx;
  margin-right: 8rpx;
}

.option-label {
  font-size: 26rpx;
  color: #999;
}

.option-check {
  margin-left: auto;
  font-size: 28rpx;
  color: #5B8DEF;
}
