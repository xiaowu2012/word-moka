<!-- 今日学习小结 -->
<view class="container">
  <view class="celebrate">
    <text class="celebrate-icon">🎉</text>
    <text class="celebrate-title">今日学习完成！</text>
    <text class="celebrate-sub">今天学习了 {{todayLearned}} 个单词</text>
    <view class="streak-tag" wx:if="{{streakCount > 1}}">
      <text>🔥 连续打卡 {{streakCount}} 天</text>
    </view>
  </view>

  <view class="word-list">
    <view class="list-title">📖 今日单词回顾</view>
    <view 
      class="word-item" 
      wx:for="{{words}}" 
      wx:key="key"
      bindtap="onTapWord"
      data-key="{{item.key}}"
    >
      <text class="word-text">{{item.word}}</text>
      <text class="word-cn">{{item.cnMeaning}}</text>
      <text class="word-arrow">›</text>
    </view>
    <view class="word-empty" wx:if="{{words.length === 0}}">
      <text>今天没有学习新单词</text>
    </view>
  </view>

  <view class="actions">
    <view class="btn-primary" bindtap="onGoReview">
      📖 去复习
    </view>
    <view class="btn-secondary" bindtap="onGoHome">
      回到首页
    </view>
  </view>
</view>
