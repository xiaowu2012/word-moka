<!-- 复习模式 - 每词单题循环 -->
<view class="container">
  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-fill" style="width: {{totalWordCount > 0 ? (passingWords / totalWordCount * 100) : 0}}%"></view>
  </view>

  <!-- 加载中 -->
  <view class="state-view" wx:if="{{phase === 'loading'}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 无待复习 -->
  <view class="state-view" wx:elif="{{phase === 'empty'}}">
    <text class="empty-icon">🎉</text>
    <text class="empty-text">今天没有待复习的单词！</text>
    <text class="empty-sub">去学新单词或明天再来吧</text>
    <view class="btn-primary" bindtap="onGoHome">返回</view>
  </view>

  <!-- 答题页面 -->
  <view class="quiz-view" wx:elif="{{phase === 'quiz'}}">
    <!-- 顶部信息 -->
    <view class="quiz-header">
      <view class="quiz-left">
        <text class="quiz-progress">已掌握 {{passingWords}}/{{totalWordCount}}</text>
      </view>
      <view class="quiz-right">
        <text class="quiz-word-status">
          <text wx:if="{{currentCorrect > 0}}">✅ {{currentCorrect}}/{{3}}  </text>
          <text wx:if="{{gapSize > 0}}">间隔 {{gapSize}}词</text>
        </text>
      </view>
    </view>

    <!-- 队列信息 -->
    <view class="queue-info">
      <text>队列 {{reviewQueue.length}} 词 · 间隔 {{gapSize}}词</text>
    </view>

    <!-- 题目卡片 -->
    <view class="question-card">
      <!-- 题目标题行：左标签 + 右复习次数 -->
      <view class="card-title-row">
        <!-- 题型1: 听音选词 -->
        <text class="q-label" wx:if="{{questionType === 1}}">请听发音，选择对应的单词</text>
        <text class="q-label" wx:elif="{{questionType === 2}}">选择正确的中文释义</text>
        <text class="q-label" wx:elif="{{questionType === 3}}">选择对应的英文单词</text>
        <text class="q-label" wx:elif="{{questionType === 4}}">请听发音，选择对应的中文释义</text>
        <text class="q-round">第 {{currentReviewRound}} 次复习</text>
      </view>
      <view class="card-body">
        <!-- 题型1: 听音选词 -->
        <block wx:if="{{questionType === 1}}">
          <view class="play-btn-lg" bindtap="onPlaySound">🔊</view>
        </block>
        <!-- 题型2: 看词选义 -->
        <block wx:if="{{questionType === 2}}">
          <text class="word-display">{{currentWord}}</text>
          <text class="word-phonetic" wx:if="{{currentPhonetic}}">{{currentPhonetic}}</text>
        </block>
        <!-- 题型3: 看义选词 -->
        <block wx:if="{{questionType === 3}}">
          <text class="meaning-display">{{currentMeaning}}</text>
        </block>
        <!-- 题型4: 听音选义 -->
        <block wx:if="{{questionType === 4}}">
          <view class="play-btn-lg" bindtap="onPlaySound">🔊</view>
        </block>
      </view>
    </view>

    <!-- 模块标签 -->
    <text class="module-tag" wx:if="{{currentModule}}">{{currentModule}}</text>

    <!-- 选项 -->
    <view class="options-list">
      <view
        wx:for="{{options}}"
        wx:key="key"
        class="option-btn
          {{answered && key === correctKey ? 'opt-correct' : ''}}
          {{answered && key === selectedKey && !isCorrect ? 'opt-wrong' : ''}}
          {{!answered ? 'opt-default' : ''}}"
        bindtap="onSelectOption"
        data-key="{{item.key}}"
        hover-class="{{answered ? '' : 'opt-hover'}}"
      >
        <text class="option-text">{{item.label}}</text>
        <text class="option-mark" wx:if="{{answered && key === correctKey}}">✓</text>
        <text class="option-mark" wx:if="{{answered && key === selectedKey && !isCorrect}}">✗</text>
      </view>
    </view>

    <!-- 答题反馈 -->
    <view class="feedback-row" wx:if="{{feedback === 'correct'}}">
      <text class="feedback-text correct-text">✅ 正确！</text>
    </view>

    <!-- 答错 → 正确答案卡片 -->
    <view class="correction-card" wx:if="{{feedback === 'wrong' || feedback === 'skip'}}">
      <view class="correction-header">
        <text class="correction-label wrong-text">❌ 答错了</text>
        <text class="correction-label skip-text" wx:if="{{feedback === 'skip'}}">⏭️ 已跳过</text>
      </view>
      <view class="correction-word-row">
        <text class="correction-word">{{currentWord}}</text>
        <text class="play-btn-sm" bindtap="onPlaySound">🔊</text>
      </view>
      <text class="correction-phonetic" wx:if="{{currentPhonetic}}">{{currentPhonetic}}</text>
      <text class="correction-meaning">{{currentMeaning}}</text>
      <text class="correction-hint">记住它，马上再来！💪</text>
    </view>
  </view>

  <!-- ===== 掌握弹窗 ===== -->
  <view class="popup-overlay" wx:if="{{showMasterPopup}}">
    <view class="popup-content">
      <text class="popup-icon">{{masterIcon}}</text>
      <text class="popup-text">{{masterMessage}}</text>
      <view class="popup-bar">
        <view class="popup-bar-fill" style="width: {{totalWordCount > 0 ? (passingWords / totalWordCount * 100) : 0}}%"></view>
      </view>
      <text class="popup-progress">{{passingWords}} / {{totalWordCount}}</text>
    </view>
  </view>

  <!-- ===== 复习完成 ===== -->
  <view class="complete-view" wx:elif="{{phase === 'complete'}}">
    <!-- 撒花粒子 -->
    <view class="confetti-container">
      <view class="confetti confetti-1">🎉</view>
      <view class="confetti confetti-2">✨</view>
      <view class="confetti confetti-3">🎊</view>
      <view class="confetti confetti-4">⭐</view>
      <view class="confetti confetti-5">🌟</view>
      <view class="confetti confetti-6">💫</view>
    </view>

    <text class="complete-icon" wx:if="{{passingWords >= totalWordCount}}">🏆</text>
    <text class="complete-icon" wx:else>🎉</text>
    <text class="complete-title">复习完成！</text>
    <text class="complete-sub">共复习 {{totalWordCount}} 个单词</text>

    <view class="result-stats">
      <view class="stat-item">
        <text class="stat-num pass-num">{{passingWords}}</text>
        <text class="stat-label">已掌握</text>
      </view>
      <view class="stat-item">
        <text class="stat-num que-num">{{totalWordCount - passingWords}}</text>
        <text class="stat-label">未通过</text>
      </view>
      <view class="stat-item">
        <text class="stat-num total-num">{{totalAnswered}}</text>
        <text class="stat-label">答题数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num acc-num">{{totalAnswered > 0 ? Math.round(correctAnswerCount / totalAnswered * 100) : 0}}%</text>
        <text class="stat-label">正确率</text>
      </view>
    </view>

    <view class="streak-card" wx:if="{{streakCount > 0}}">
      <text class="streak-fire">🔥</text>
      <text class="streak-num">{{streakCount}}</text>
      <text class="streak-label">天连续打卡</text>
    </view>

    <view class="btn-primary" bindtap="onGoHome">返回</view>
  </view>
</view>
