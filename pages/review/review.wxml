<!-- 复习模式 - 选择题型 -->
<view class="container">
  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-fill" style="width: {{reviewWords.length > 0 ? (wordIndex / reviewWords.length * 100) : 0}}%"></view>
  </view>

  <!-- 加载中 -->
  <view class="state-view" wx:if="{{phase === 'loading'}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 无待复习 -->
  <view class="state-view" wx:elif="{{phase === 'empty'}}">
    <text class="empty-icon">🎉</text>
    <text class="empty-text">今天没有待复习的单词！</text>
    <text class="empty-sub">去学新单词或明天再来吧</text>
    <view class="btn-primary" bindtap="onGoHome">返回</view>
  </view>

  <!-- 答题页面 -->
  <view class="quiz-view" wx:elif="{{phase === 'quiz'}}">
    <!-- 顶部信息 -->
    <view class="quiz-header">
      <text class="quiz-progress">{{wordIndex + 1}} / {{reviewWords.length}}</text>
      <text class="quiz-stats">答对 {{sessionCorrectCount}}/{{3}}</text>
    </view>

    <!-- 进度条(当前词) -->
    <view class="session-bar">
      <view class="session-fill" style="width: {{sessionBar}}%"></view>
    </view>

    <!-- 题目区域 -->
    <view class="question-card">
      <!-- 题型1: 听音选词 -->
      <block wx:if="{{questionType === 1}}">
        <view class="audio-area">
          <view class="play-btn-lg" bindtap="onPlaySound">🔊</view>
          <text class="question-label">听发音，选择对应的单词</text>
        </view>
      </block>

      <!-- 题型2: 看词选义 -->
      <block wx:if="{{questionType === 2}}">
        <view class="word-area">
          <text class="word-display">{{currentWord}}</text>
          <text class="word-phonetic">{{currentPhonetic}}</text>
          <text class="question-label">选择正确的中文释义</text>
        </view>
      </block>

      <!-- 题型3: 看义选词 -->
      <block wx:if="{{questionType === 3}}">
        <view class="meaning-area">
          <text class="meaning-display">{{currentMeaning}}</text>
          <text class="question-label">选择对应的英文单词</text>
        </view>
      </block>

      <!-- 题型4: 听音选义 -->
      <block wx:if="{{questionType === 4}}">
        <view class="audio-area">
          <view class="play-btn-lg" bindtap="onPlaySound">🔊</view>
          <text class="question-label">听发音，选择对应的中文释义</text>
        </view>
      </block>
    </view>

    <!-- 模块标签 -->
    <text class="module-tag" wx:if="{{currentModule}}">{{currentModule}}</text>

    <!-- 选项按钮 -->
    <view class="options-list">
      <view
        wx:for="{{options}}"
        wx:key="key"
        class="option-btn
          {{answered && key === correctKey ? 'option-correct' : ''}}
          {{answered && key === selectedKey && !isCorrect ? 'option-wrong' : ''}}
          {{!answered ? 'option-default' : ''}}"
        bindtap="onSelectOption"
        data-key="{{item.key}}"
        hover-class="{{answered ? '' : 'option-hover'}}"
      >
        <text class="option-text">{{item.label}}</text>
        <text class="option-mark" wx:if="{{answered && key === correctKey}}">✓</text>
        <text class="option-mark" wx:if="{{answered && key === selectedKey && !isCorrect}}">✗</text>
      </view>
    </view>

    <!-- 答题反馈 -->
    <view class="feedback-bar" wx:if="{{feedback === 'correct'}}">
      <text class="feedback-text correct-text">{{sessionProgress}}</text>
    </view>
    <view class="feedback-bar" wx:elif="{{feedback === 'wrong'}}">
      <text class="feedback-text wrong-text">{{sessionProgress}}</text>
    </view>
  </view>

  <!-- 复习完成 -->
  <view class="complete-view" wx:elif="{{phase === 'complete'}}">
    <text class="complete-icon">🎉</text>
    <text class="complete-title">复习完成！</text>
    <text class="complete-sub">共复习 {{reviewWords.length}} 个单词</text>

    <view class="result-stats">
      <view class="stat-item">
        <text class="stat-num pass-num">{{passingWords}}</text>
        <text class="stat-label">通过</text>
      </view>
      <view class="stat-item">
        <text class="stat-num fail-num">{{failingWords}}</text>
        <text class="stat-label">未通过</text>
      </view>
      <view class="stat-item">
        <text class="stat-num total-num">{{totalAnswered}}</text>
        <text class="stat-label">答题数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num acc-num">{{totalAnswered > 0 ? Math.round(correctCount / totalAnswered * 100) : 0}}%</text>
        <text class="stat-label">正确率</text>
      </view>
    </view>

    <view class="streak-card" wx:if="{{streakCount > 0}}">
      <text class="streak-fire">🔥</text>
      <text class="streak-num">{{streakCount}}</text>
      <text class="streak-label">天连续打卡</text>
    </view>

    <view class="btn-primary" bindtap="onGoHome">返回</view>
  </view>
</view>
