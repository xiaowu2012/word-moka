.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 24rpx;
  min-height: 100vh;
  position: relative;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B8DEF, #7C6FF7);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

/* 状态页 */
.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

/* 答题区 */
.quiz-view {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quiz-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.quiz-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quiz-progress {
  font-size: 28rpx;
  color: #2C3E50;
  font-weight: 600;
}

.quiz-word-status {
  font-size: 22rpx;
  color: #27AE60;
  font-weight: 500;
}

/* 队列信息 */
.queue-info {
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  margin-bottom: 20rpx;
}

/* 题目卡片 */
.question-card {
  width: 100%;
  min-height: 320rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 40rpx 40rpx;
  margin-bottom: 12rpx;
}

/* 题目标签（左上角） */
.q-label {
  font-size: 28rpx;
  color: #888;
  text-align: left;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

/* 卡片主体内容（居中） */
.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}

.play-btn-lg {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  background: #F0F4FF;
  border-radius: 50%;
}

.play-btn-lg:active {
  background: #E0E8FF;
}

.word-display {
  font-size: 56rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.word-phonetic {
  font-size: 28rpx;
  color: #aaa;
  margin-bottom: 24rpx;
}

/* 看义题型 */
.meaning-area {
  text-align: center;
}

.meaning-display {
  font-size: 48rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 24rpx;
}

.question-label {
  font-size: 26rpx;
  color: #999;
}

/* 模块标签 */
.module-tag {
  font-size: 22rpx;
  color: #5B8DEF;
  background: #EEF3FF;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

/* 选项列表 */
.options-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.option-btn {
  width: 100%;
  padding: 32rpx 36rpx;
  border-radius: 16rpx;
  font-size: 34rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.opt-default {
  background: rgba(255, 255, 255, 0.85);
  border-color: #e0e0e0;
  color: #2C3E50;
  backdrop-filter: blur(4rpx);
}

.opt-hover {
  background: rgba(91, 141, 239, 0.08);
  border-color: #5B8DEF;
}

.opt-correct {
  background: #27AE60;
  border-color: #27AE60;
  color: #fff;
  font-weight: 700;
}

.opt-wrong {
  background: #E67E22;
  border-color: #E67E22;
  color: #fff;
  font-weight: 700;
}

.option-text {
  flex: 1;
  line-height: 1.4;
}

.option-mark {
  font-size: 36rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 反馈 */
.feedback-row {
  width: 100%;
  padding: 12rpx 0;
  text-align: center;
}

.feedback-text {
  font-size: 28rpx;
  font-weight: 500;
}

.correct-text {
  color: #27AE60;
}

.wrong-text {
  color: #E67E22;
}

.skip-text {
  color: #E67E22;
}

/* 正确答案卡片 */
.correction-card {
  width: 100%;
  background: #FFF8F0;
  border: 2rpx solid #FDEBD0;
  border-radius: 20rpx;
  padding: 30rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 12rpx;
  animation: cardSlideIn 0.25s ease;
}

.correction-header {
  margin-bottom: 12rpx;
}

.correction-label {
  font-size: 26rpx;
  font-weight: 600;
}

.correction-word-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.correction-word {
  font-size: 48rpx;
  font-weight: 700;
  color: #2C3E50;
}

.play-btn-sm {
  font-size: 36rpx;
  padding: 8rpx;
}

.play-btn-sm:active {
  opacity: 0.6;
}

.correction-phonetic {
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 8rpx;
}

.correction-meaning {
  font-size: 34rpx;
  color: #E67E22;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.correction-hint {
  font-size: 24rpx;
  color: #bbb;
}

@keyframes cardSlideIn {
  from { transform: translateY(20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* ===== 掌握弹窗 ===== */
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: fadeIn 0.2s ease;
}

.popup-content {
  background: #fff;
  border-radius: 28rpx;
  padding: 50rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
  animation: popIn 0.3s ease;
  min-width: 500rpx;
}

.popup-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.popup-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E50;
  text-align: center;
  margin-bottom: 24rpx;
}

.popup-bar {
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.popup-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #27AE60, #2ECC71);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.popup-progress {
  font-size: 26rpx;
  color: #999;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  from { transform: scale(0.7); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* ===== 完成页 ===== */
.complete-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  width: 100%;
}

.complete-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.complete-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.complete-sub {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 36rpx;
}

/* 统计卡片 */
.result-stats {
  width: 100%;
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.pass-num { color: #27AE60; }
.que-num { color: #E74C3C; }
.total-num { color: #5B8DEF; }
.acc-num { color: #E67E22; }

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 连续打卡 */
.streak-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #FFF8E8;
  border-radius: 40rpx;
  padding: 16rpx 36rpx;
  margin-bottom: 40rpx;
}

.streak-fire {
  font-size: 36rpx;
}

.streak-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #E67E22;
}

.streak-label {
  font-size: 26rpx;
  color: #E67E22;
}

.btn-primary {
  background: linear-gradient(135deg, #5B8DEF, #7C6FF7);
  color: #fff;
  border-radius: 40rpx;
  padding: 24rpx 80rpx;
  font-size: 30rpx;
}

.btn-primary:active {
  opacity: 0.85;
}

/* ===== 撒花粒子 ===== */
.confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 100vh;
  pointer-events: none;
  overflow: hidden;
  z-index: 50;
}

.confetti {
  position: absolute;
  font-size: 40rpx;
  opacity: 0.8;
}

.confetti-1 {
  top: -40rpx;
  left: 10%;
  animation: confettiFall 3s ease-in-out 0s infinite;
}

.confetti-2 {
  top: -40rpx;
  left: 30%;
  animation: confettiFall 3.5s ease-in-out 0.3s infinite;
}

.confetti-3 {
  top: -40rpx;
  left: 50%;
  animation: confettiFall 2.8s ease-in-out 0.6s infinite;
}

.confetti-4 {
  top: -40rpx;
  left: 70%;
  animation: confettiFall 3.2s ease-in-out 0.9s infinite;
}

.confetti-5 {
  top: -40rpx;
  left: 85%;
  animation: confettiFall 3.8s ease-in-out 0.2s infinite;
}

.confetti-6 {
  top: -40rpx;
  left: 20%;
  animation: confettiFall 2.5s ease-in-out 0.7s infinite;
}

@keyframes confettiFall {
  0% {
    top: -40rpx;
    opacity: 1;
    transform: rotate(0deg);
  }
  50% {
    opacity: 0.9;
  }
  100% {
    top: 100vh;
    opacity: 0;
    transform: rotate(360deg);
  }
}
