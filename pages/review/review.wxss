.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 4rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B8DEF, #7C6FF7);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.card {
  width: 100%;
  margin-bottom: 40rpx;
}

.card-inner {
  width: 100%;
  min-height: 400rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  padding: 60rpx 40rpx;
  transition: all 0.3s;
}

.card-inner:active {
  transform: scale(0.98);
}

.review-word {
  font-size: 52rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 16rpx;
}

.review-hint {
  font-size: 26rpx;
  color: #ccc;
}

.review-phonetic {
  font-size: 28rpx;
  color: #aaa;
  margin-bottom: 20rpx;
}

.review-mean {
  font-size: 40rpx;
  color: #E67E22;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.review-stars {
  text-align: center;
}

.stars {
  color: #F1C40F;
  font-size: 28rpx;
}

/* 加载/空状态 */
.loading-state, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

/* 复习次数标签 */
.review-stage {
  margin-top: 12rpx;
}

.stage-tag {
  font-size: 22rpx;
  color: #5B8DEF;
  background: #EEF3FF;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

/* 操作按钮 */
.review-actions {
  width: 100%;
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
}

.action-btn:active {
  opacity: 0.8;
}

.btn-hard {
  background: #FFF0F0;
  color: #E74C3C;
}

.btn-good {
  background: #F0F4FF;
  color: #5B8DEF;
}

.btn-easy {
  background: #E8F8E8;
  color: #27AE60;
}

/* 完成页面 */
.completed {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}

.completed-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.completed-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.completed-sub {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #5B8DEF, #7C6FF7);
  color: #fff;
  border-radius: 40rpx;
  padding: 24rpx 80rpx;
  font-size: 30rpx;
}

.btn-primary:active {
  opacity: 0.85;
}
