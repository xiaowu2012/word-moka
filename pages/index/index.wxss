.container {
  padding-bottom: 120rpx;
}

.header {
  width: 100%;
}

.header-img {
  width: 100%;
  display: block;
}

.textbook-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.tb-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 6rpx;
}

.tb-sub {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.tb-count {
  font-size: 24rpx;
  color: #5B8DEF;
}

.unit-list {
  padding: 16rpx 24rpx;
}

.unit-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.unit-card:active {
  transform: scale(0.98);
}

.unit-left {
  display: flex;
  align-items: center;
}

.unit-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.unit-info {
  display: flex;
  flex-direction: column;
}

.unit-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 4rpx;
}

.unit-count {
  font-size: 24rpx;
  color: #999;
}

.unit-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.unit-status {
  font-size: 24rpx;
  color: #5B8DEF;
}

.unit-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bottom-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.bottom-btn:active {
  opacity: 0.85;
}

.review-btn {
  background: linear-gradient(135deg, #5B8DEF, #7C6FF7);
  color: #fff;
}

.list-btn {
  background: #F0F4FF;
  color: #5B8DEF;
}
