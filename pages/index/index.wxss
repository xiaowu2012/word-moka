.container {
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(180deg, #5B8DEF 0%, #7C6FF7 100%);
  padding: 60rpx 32rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  padding: 40rpx 24rpx 20rpx;
}

.textbook-list {
  padding: 0 24rpx;
}

.textbook-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.textbook-card:active {
  transform: scale(0.98);
  transition: transform 0.1s;
}

.textbook-left {
  display: flex;
  align-items: center;
}

.textbook-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: #F5F7FA;
  margin-right: 20rpx;
}

.textbook-info {
  display: flex;
  flex-direction: column;
}

.textbook-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 4rpx;
}

.textbook-count {
  font-size: 24rpx;
  color: #999;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-ready {
  background: #E8F8E8;
  color: #27AE60;
}

.status-coming {
  background: #FFF3E8;
  color: #E67E22;
}
