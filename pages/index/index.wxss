.container { padding-bottom: 40rpx; }
.header-img { width: 100%; display: block; }
.section-title { font-size: 32rpx; font-weight: 700; color: #2C3E50; padding: 40rpx 24rpx 20rpx; }

/* ========== 课本选择 ========== */
.book-list { padding: 0 24rpx; }
.book-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.book-card:active { transform: scale(0.98); }
.book-icon { font-size: 52rpx; margin-right: 20rpx; display: flex; align-items: center; }
.book-info { flex: 1; }
.book-name { font-size: 30rpx; font-weight: 700; color: #2C3E50; display: block; }
.book-count { font-size: 22rpx; color: #5B8DEF; display: block; margin-top: 4rpx; }
.book-status {
  font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx;
  display: inline-flex; align-items: center; justify-content: center; line-height: 1.2;
}
.book-status.ready { background: #E8F8E8; color: #27AE60; }
.book-status.coming { background: #FFF3E8; color: #E67E22; }

/* ========== 返回按钮 ========== */
.back-btn { font-size: 36rpx; color: #5B8DEF; display: block; padding: 30rpx 24rpx 20rpx; }

/* ========== 教材简介 ========== */
.book-intro {
  display: flex; align-items: center;
  margin: 0 24rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx; padding: 32rpx;
}
.intro-cover { font-size: 72rpx; margin-right: 24rpx; }
.intro-info { flex: 1; }
.intro-name { font-size: 34rpx; font-weight: 700; color: #fff; display: block; }
.intro-meta { font-size: 24rpx; color: rgba(255,255,255,0.85); display: block; margin-top: 6rpx; }

/* ========== 三入口卡片 ========== */
.entry-cards { padding: 0 24rpx; }
.entry-card {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.entry-card:active { transform: scale(0.98); }

.entry-left { display: flex; align-items: center; flex: 1; }
.entry-icon { font-size: 48rpx; margin-right: 20rpx; }
.entry-info { flex: 1; }
.entry-title { font-size: 30rpx; font-weight: 700; color: #2C3E50; display: block; }
.entry-desc { font-size: 24rpx; color: #95A5A6; display: block; margin-top: 4rpx; }
.entry-arrow { font-size: 40rpx; color: #BDC3C7; margin-left: 16rpx; }

/* ========== 单元列表 ========== */
.unit-card {
  margin: 0 24rpx 16rpx; padding: 24rpx;
  background: #fff; border-radius: 14rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}
.unit-card:active { transform: scale(0.98); }
.unit-card.disabled { opacity: 0.5; }

.unit-row { display: flex; align-items: center; justify-content: space-between; }
.unit-name { font-size: 28rpx; font-weight: 600; color: #2C3E50; flex: 1; }

.unit-badge {
  font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 20rpx;
  display: inline-flex; align-items: center; justify-content: center; line-height: 1.2;
  white-space: nowrap;
}
.badge-ready { background: #E8F8E8; color: #27AE60; }
.badge-word { background: #FFF5E6; color: #E67E22; }
.badge-coming { background: #F0F0F0; color: #95A5A6; }
