.container {
  padding-bottom: 40rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

.header-img {
  width: 100%;
  display: block;
}

/* ========== 标题 ========== */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E50;
  padding: 40rpx 28rpx 24rpx;
}

/* 教材信息行（单词数 + 待复习数） */
.intro-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
}

.intro-meta {
  font-size: 24rpx;
  color: #95A5A6;
}

.book-review-count {
  font-size: 24rpx;
  color: #E67E22;
  font-weight: 700;
  background: #FFF3E6;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
}

/* ========== 返回按钮 ========== */
.back-btn {
  font-size: 32rpx;
  color: #5B8DEF;
  display: block;
  padding: 28rpx 28rpx 16rpx;
}

/* ========== 教材卡片 ========== */
.book-list {
  padding: 0 24rpx;
}

.book-intro {
  display: flex;
  align-items: center;
  margin: 0 0 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid #5B8DEF;
}

.book-intro:active {
  opacity: 0.85;
}

/* 未上架 */
.book-intro.disabled {
  border-left-color: #ddd;
  background: #f9f9fb;
  box-shadow: none;
}

.book-intro.disabled .intro-cover {
  opacity: 0.4;
}

.book-intro.disabled .intro-name {
  color: #bbb;
  font-weight: 400;
}

.book-intro.disabled .intro-meta {
  color: #d0d0d0;
}

.book-intro.disabled .intro-meta-row {
  opacity: 0.4;
}

.book-intro.disabled:active {
  opacity: 1;
}

.intro-cover {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.intro-info {
  flex: 1;
}

.intro-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E50;
  display: block;
}



/* 教材详情页的卡片（蓝色背景） */
.detail-section {
  padding: 0 24rpx;
}

.detail-section .book-intro {
  margin-bottom: 28rpx;
}

.detail-section .entry-cards {
  padding: 0;
}

/* ========== 三入口卡片 ========== */
.entry-cards {
  padding: 0 24rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.entry-card:active {
  opacity: 0.85;
}

.entry-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.entry-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.entry-info {
  flex: 1;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E50;
  display: block;
}

.entry-desc {
  font-size: 24rpx;
  color: #95A5A6;
  display: block;
  margin-top: 4rpx;
}

.entry-arrow {
  font-size: 40rpx;
  color: #BDC3C7;
  margin-left: 16rpx;
}

.entry-badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  white-space: nowrap;
  margin-left: 16rpx;
}

.badge-due {
  background: #FFF0F0;
  color: #E74C3C;
}

.badge-none {
  display: none;
}

/* ========== 单元列表 ========== */
.unit-card {
  margin: 0 24rpx 14rpx;
  padding: 26rpx 24rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.unit-card:active {
  opacity: 0.85;
}

.unit-card.disabled {
  opacity: 0.45;
}

.unit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.unit-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E50;
  flex: 1;
}

.unit-badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  white-space: nowrap;
}

.badge-ready {
  background: #E8F8E8;
  color: #27AE60;
}

.badge-word {
  background: #FFF5E6;
  color: #E67E22;
}

.badge-coming {
  background: #F0F0F0;
  color: #bbb;
}

/* ========== 复习提醒弹框 ========== */
.popup-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: fadeIn 0.2s ease;
}

.popup-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 50rpx 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.12);
  animation: popIn 0.3s ease;
  min-width: 520rpx;
  max-width: 620rpx;
}

.popup-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 16rpx;
}

.popup-body {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.popup-count {
  font-size: 40rpx;
  font-weight: 800;
  color: #5B8DEF;
}

.popup-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.popup-btn {
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.popup-btn:active {
  opacity: 0.85;
}

.btn-primary {
  background: linear-gradient(135deg, #5B8DEF, #7C6FF7);
  color: #fff;
}

.btn-secondary {
  background: #f5f5f5;
  color: #999;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  from { transform: scale(0.7); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
