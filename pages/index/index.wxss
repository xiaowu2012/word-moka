.container {
  padding-bottom: 40rpx;
}

/* 头部渐变 */
.header {
  background: linear-gradient(180deg, #5B8DEF 0%, #7C6FF7 100%);
  padding: 60rpx 32rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.app-name {
  font-size: 44rpx; font-weight: 700; color: #fff; margin-bottom: 10rpx;
}
.app-desc {
  font-size: 26rpx; color: rgba(255,255,255,0.8);
}

/* 教材选择 */
.section-title {
  font-size: 32rpx; font-weight: 700; color: #2C3E50;
  padding: 40rpx 24rpx 20rpx;
}
.book-list { padding: 0 24rpx; }
.book-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 16rpx;
  padding: 28rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.book-card:active { transform: scale(0.98); }
.book-icon { font-size: 52rpx; margin-right: 20rpx; }
.book-info { flex: 1; }
.book-name { font-size: 30rpx; font-weight: 700; color: #2C3E50; display: block; }
.book-sub { font-size: 24rpx; color: #999; display: block; margin-top: 4rpx; }
.book-count { font-size: 22rpx; color: #5B8DEF; display: block; margin-top: 4rpx; }
.book-status {
  font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx;
}
.book-status.ready { background: #5B8DEF; color: #fff; }
.book-status.coming { background: #F0F0F0; color: #aaa; }

/* 单元列表头部 */
.unit-header {
  display: flex; align-items: center;
  background: linear-gradient(180deg, #5B8DEF 0%, #7C6FF7 100%);
  padding: 40rpx 24rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.back-btn { font-size: 52rpx; color: #fff; margin-right: 16rpx; }
.unit-header-info { flex: 1; }
.unit-header-name { font-size: 34rpx; font-weight: 700; color: #fff; display: block; }
.unit-header-sub { font-size: 24rpx; color: rgba(255,255,255,0.75); display: block; margin-top: 4rpx; }

/* 单元列表 */
.unit-list { padding: 20rpx 24rpx; }
.unit-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 14rpx;
  padding: 22rpx 24rpx; margin-bottom: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}
.unit-card:active { transform: scale(0.98); }
.unit-icon { font-size: 36rpx; margin-right: 16rpx; }
.unit-info { flex: 1; }
.unit-name { font-size: 28rpx; font-weight: 600; color: #2C3E50; display: block; }
.unit-progress { font-size: 24rpx; color: #5B8DEF; display: block; margin-top: 4rpx; }
.unit-arrow { font-size: 36rpx; color: #ccc; }
