<view class="container">
  <!-- 加载提示 -->
  <text wx:if="{{!showUnits}}" class="tap-hint" bindtap="onTapBook">
    点我查看单元列表
  </text>

  <!-- 单元列表 -->
  <view wx:else>
    <text class="back-btn" bindtap="onBack">‹ 返回</text>

    <view class="unit-card" bindtap="onReadText" data-id="Unit1">
      <text>🎭 Unit 1 - Teenagers today</text>
    </view>
    <view class="unit-card" bindtap="onReadText" data-id="Unit2">
      <text>💰 Unit 2 - On the money</text>
    </view>
    <view class="unit-card" bindtap="onReadText" data-id="Unit3">
      <text>🧩 Unit 3 - Putting the pieces together</text>
    </view>
    <view class="unit-card" bindtap="onReadText" data-id="Unit4">
      <text>⏳ Unit 4 - Past passing by</text>
    </view>
    <view class="unit-card" bindtap="onReadText" data-id="Unit5">
      <text>⚖️ Unit 5 - A fine balance</text>
    </view>
    <view class="unit-card" bindtap="onReadText" data-id="Unit6">
      <text>🌿 Unit 6 - Live green</text>
    </view>
  </view>
</view>
