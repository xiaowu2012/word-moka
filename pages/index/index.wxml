<!-- 首页 - 课本封面 + 单元列表 -->
<view class="container">
  <view class="header">
    <image class="header-img" src="/images/home-banner.jpg" mode="widthFix"></image>
  </view>

  <view class="textbook-info">
    <text class="tb-name">九年级上册</text>
    <text class="tb-sub">2026秋季版 · 外研社</text>
    <text class="tb-count">{{totalWords}}个单词</text>
  </view>

  <view class="unit-list">
    <view 
      class="unit-card" 
      wx:for="{{units}}" 
      wx:key="id"
      bindtap="onTapUnit"
      data-id="{{item.id}}"
    >
      <view class="unit-left">
        <text class="unit-icon">{{item.icon}}</text>
        <view class="unit-info">
          <text class="unit-name">{{item.name}}</text>
          <text class="unit-count">{{item.wordCount}}个单词</text>
        </view>
      </view>
      <view class="unit-right">
        <text class="unit-status">{{item.progress > 0 ? item.progress + '/' + item.wordCount : '未开始'}}</text>
        <text class="unit-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="bottom-btn review-btn" bindtap="onReview">
      <text>🔄 今日复习</text>
    </view>
    <view class="bottom-btn list-btn" bindtap="onAllWords">
      <text>📝 全部单词</text>
    </view>
  </view>
</view>
