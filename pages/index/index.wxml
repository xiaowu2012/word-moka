<view class="container">

  <!-- 课本选择 -->
  <view wx:if="{{!showUnits}}">
    <image class="header-img" src="/images/home-banner.jpg" mode="widthFix"></image>
    <view class="section-title">选择课本</view>
    <view class="book-list">
      <view class="book-card" wx:for="{{textbooks}}" wx:key="id"
            bindtap="onTapBook" data-id="{{item.id}}">
        <view class="book-icon"><text>{{item.cover}}</text></view>
        <view class="book-info">
          <text class="book-name">{{item.name}}</text>
          <text class="book-count" wx:if="{{item.available}}">{{item.wordCount}}个单词</text>
        </view>
        <view class="book-status {{item.available ? 'ready' : 'coming'}}">
          <text>{{item.available ? '已解锁' : '即将上线'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 单元列表 -->
  <view wx:else>
    <image class="header-img" src="/images/home-banner.jpg" mode="widthFix"></image>
    <view class="back-btn" bindtap="onBack"><text>‹ 返回</text></view>
    <view class="unit-card {{item.available ? '' : 'disabled'}}" wx:for="{{units}}" wx:key="id">
      <view class="unit-header">
        <text class="unit-name">{{item.icon}} {{item.name}}</text>
        <text class="unit-status {{item.available ? 'ready' : 'coming'}}">{{item.available ? '已上线' : '即将上线'}}</text>
      </view>
      <view wx:if="{{item.available}}" class="unit-actions">
        <button class="action-btn read-btn" bindtap="onReadText" data-id="{{item.id}}">📖 课文领读</button>
        <button class="action-btn word-btn" bindtap="onLearnWords" data-id="{{item.id}}">📚 学单词</button>
      </view>
    </view>
  </view>

</view>
