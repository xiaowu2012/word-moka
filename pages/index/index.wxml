<view class="container">

  <!-- 课本选择 -->
  <view wx:if="{{!showUnits}}">
    <image class="header-img" src="/images/home-banner.jpg" mode="widthFix"></image>
    <view class="section-title">选择课本</view>
    <view class="book-list">
      <view class="book-card" wx:for="{{textbooks}}" wx:key="id"
            bindtap="onTapBook" data-id="{{item.id}}">
        <text class="book-icon">{{item.cover}}</text>
        <view class="book-info">
          <text class="book-name">{{item.name}}</text>
          <text class="book-count" wx:if="{{item.available}}">{{item.wordCount}}个单词</text>
        </view>
        <text class="book-status {{item.available ? 'ready' : 'coming'}}">
          {{item.available ? '已解锁' : '即将上线'}}
        </text>
      </view>
    </view>
  </view>

  <!-- 单元列表 -->
  <view wx:else>
    <text class="back-btn" bindtap="onBack">‹ 返回</text>
    <view class="unit-card" wx:for="{{units}}" wx:key="id"
          bindtap="onReadText" data-id="{{item.id}}">
      <text>{{item.icon}} {{item.name}}</text>
    </view>
  </view>

</view>
