<!-- 首页 -->
<view class="container">

  <!-- 模式1: 课本选择 -->
  <view wx:if="{{!showUnits}}">
    <view class="header">
      <view class="header-content">
        <text class="app-name">单词魔卡</text>
        <text class="app-desc">初中英语课本同步</text>
      </view>
    </view>

    <view class="section-title">选择课本</view>

    <view class="book-list">
      <view 
        class="book-card" 
        wx:for="{{textbooks}}" wx:key="id"
        bindtap="onTapBook" data-id="{{item.id}}"
      >
        <text class="book-icon">{{item.cover}}</text>
        <view class="book-info">
          <text class="book-name">{{item.name}}</text>
          <text class="book-sub">{{item.subtitle}}</text>
          <text class="book-count" wx:if="{{item.available}}">{{item.wordCount}}个单词</text>
        </view>
        <text class="book-status {{item.available ? 'ready' : 'coming'}}">
          {{item.available ? '已解锁' : '即将上线'}}
        </text>
      </view>
    </view>
  </view>

  <!-- 模式2: 单元列表 -->
  <view wx:else>
    <view class="unit-header">
      <text class="back-btn" bindtap="onBack">‹</text>
      <view class="unit-header-info">
        <text class="unit-header-name">{{selectedTextbook.cover}} {{selectedTextbook.name}}</text>
        <text class="unit-header-sub">{{selectedTextbook.subtitle}}</text>
      </view>
    </view>

    <view class="unit-list">
      <view 
        class="unit-card" 
        wx:for="{{units}}" wx:key="id"
        bindtap="onTapUnit" data-id="{{item.id}}"
      >
        <text class="unit-icon">{{item.icon}}</text>
        <view class="unit-info">
          <text class="unit-name">{{item.name}}</text>
          <text class="unit-progress">{{item.learned}}/{{item.total}} 词</text>
        </view>
        <text class="unit-arrow">›</text>
      </view>
    </view>
  </view>

</view>
