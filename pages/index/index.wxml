<view class="container">

  <!-- ========== 课本选择 ========== -->
  <block wx:if="{{pageState === 'books'}}">
    <image class="header-img" src="/images/home-banner.jpg" mode="widthFix"></image>
    <view class="section-title">选择课本</view>
    <view class="book-list">
      <view class="book-intro {{item.available ? '' : 'disabled'}}" wx:for="{{textbooks}}" wx:key="id"
            bindtap="{{item.available ? 'onTapBook' : ''}}" data-id="{{item.id}}">
        <text class="intro-cover">{{item.cover}}</text>
        <view class="intro-info">
          <text class="intro-name">{{item.name}}</text>
          <view class="intro-meta-row">
            <text class="intro-meta" wx:if="{{item.available}}">{{item.unitCount}}个单元 · {{item.wordCount}}个单词</text>
            <text class="intro-meta" wx:else>即将上线</text>
            <text class="book-review-count" wx:if="{{item.reviewCount > 0}}">{{item.reviewCount}}个需要复习</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ========== 教材详情 ========== -->
  <block wx:elif="{{pageState === 'detail'}}">
    <image class="header-img" src="/images/home-banner.jpg" mode="widthFix"></image>
    <view class="back-btn" bindtap="onBack"><text>‹ 返回</text></view>

    <view class="detail-section">
    <!-- 教材简介 -->
    <view class="book-intro">
      <text class="intro-cover">{{currentBook.cover}}</text>
      <view class="intro-info">
        <text class="intro-name">{{currentBook.name}}</text>
        <view class="intro-meta-row">
          <text class="intro-meta">{{currentBook.unitCount}}个单元 · {{currentBook.wordCount}}个单词</text>
          <text class="book-review-count" wx:if="{{currentBook.reviewCount > 0}}">{{currentBook.reviewCount}}个需要复习</text>
        </view>
      </view>
    </view>

    <!-- 入口卡片 -->
    <view class="entry-cards">
      <view class="entry-card" wx:if="{{currentBook.hasTextReading}}" bindtap="onReadText">
        <view class="entry-left">
          <text class="entry-icon">📖</text>
          <view class="entry-info">
            <text class="entry-title">课文领读</text>
            <text class="entry-desc">按单元学习课文内容</text>
          </view>
        </view>
        <text class="entry-arrow">›</text>
      </view>

      <view class="entry-card" bindtap="onLearnWordsByUnit">
        <view class="entry-left">
          <text class="entry-icon">📚</text>
          <view class="entry-info">
            <text class="entry-title">按单元学单词</text>
            <text class="entry-desc">逐单元掌握单词</text>
          </view>
        </view>
        <text class="entry-arrow">›</text>
      </view>

      <view class="entry-card" bindtap="onAllWords">
        <view class="entry-left">
          <text class="entry-icon">📝</text>
          <view class="entry-info">
            <text class="entry-title">学习全部单词</text>
            <text class="entry-desc">全书{{currentBook.wordCount}}个单词学习</text>
          </view>
        </view>
        <text class="entry-arrow">›</text>
      </view>

      <view class="entry-card" bindtap="onContinueLearning">
        <view class="entry-left">
          <text class="entry-icon">🚀</text>
          <view class="entry-info">
            <text class="entry-title">继续学习</text>
            <text class="entry-desc">继续学习下一个新单词</text>
          </view>
        </view>
        <text class="entry-arrow">›</text>
      </view>

      <view class="entry-card" bindtap="onReview">
        <view class="entry-left">
          <text class="entry-icon">🔄</text>
          <view class="entry-info">
            <text class="entry-title">每日复习</text>
            <text class="entry-desc review-desc" wx:if="{{currentBook.reviewCount > 0}}">{{currentBook.reviewCount}}个单词需要复习</text>
            <text class="entry-desc" wx:else>暂无待复习单词</text>
          </view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
    </view>
    </view>
  </block>

  <!-- ========== 单元列表 ========== -->
  <block wx:elif="{{pageState === 'units'}}">
    <image class="header-img" src="/images/home-banner.jpg" mode="widthFix"></image>
    <view class="back-btn" bindtap="onShowDetail"><text>‹ 返回</text></view>
    <view class="section-title">{{unitMode === 'read' ? '📖 选择课文' : '📚 选择单元'}}</view>
    <view class="unit-card {{item.available ? '' : 'disabled'}}" wx:for="{{units}}" wx:key="id"
          bindtap="{{item.available ? 'onTapUnit' : ''}}" data-id="{{item.id}}">
      <view class="unit-row">
        <text class="unit-name">{{item.icon}} {{item.name}}</text>
        <view class="unit-badge {{item.available ? (unitMode === 'read' ? 'badge-ready' : 'badge-word') : 'badge-coming'}}">
          {{item.available ? (unitMode === 'read' ? '已上线' : (item.wordCount + '个单词')) : '即将上线'}}
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 复习提醒弹框（多教材汇总） ===== -->
  <view class="popup-overlay" wx:if="{{showReviewReminder}}">
    <view class="popup-card">
      <text class="popup-icon">📚</text>
      <text class="popup-title">复习提醒</text>
      <text class="popup-body">有 <text class="popup-count">{{reminderBooks.length}}</text> 本教材的单词需要复习</text>
      <view class="popup-book-list">
        <view class="popup-book-item" wx:for="{{reminderBooks}}" wx:key="id"
              data-id="{{item.id}}" bindtap="onReminderReview">
          <text class="popup-book-cover">{{item.cover}}</text>
          <text class="popup-book-name">{{item.name}}</text>
          <text class="popup-book-count">{{item.reviewCount}}个词</text>
          <text class="popup-book-arrow">›</text>
        </view>
      </view>
      <view class="popup-actions">
        <view class="popup-btn btn-secondary" bindtap="onReminderSkipAll">今天算了</view>
      </view>
    </view>
  </view>
</view>
