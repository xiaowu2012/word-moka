<!-- 首页 - 教材选择 -->
<view class="container">
  <view class="header">
    <view class="header-content">
      <text class="app-name">单词魔卡</text>
      <text class="app-desc">初中英语课本同步 · 艾宾浩斯记忆</text>
    </view>
  </view>

  <view class="section-title">选择教材</view>

  <view class="textbook-list">
    <view 
      class="textbook-card" 
      wx:for="{{textbooks}}" 
      wx:key="id"
      bindtap="onTapTextbook"
      data-id="{{item.id}}"
    >
      <view class="textbook-left">
        <view class="textbook-cover">{{item.cover}}</view>
        <view class="textbook-info">
          <text class="textbook-name">{{item.name}}</text>
          <text class="textbook-count">{{item.wordCount}}个单词</text>
        </view>
      </view>
      <view class="textbook-status">
        <text wx:if="{{!item.available && item.comingSoon}}" class="status-tag status-coming">即将上线</text>
        <text wx:elif="{{unlockedObj[item.id]}}" class="status-tag status-unlocked">✅ 已解锁</text>
        <text wx:else class="status-tag status-locked">🔒 解锁</text>
      </view>
    </view>
  </view>

  <!-- 解锁弹窗 -->
  <view class="unlock-mask" wx:if="{{showUnlock}}" bindtap="onCloseUnlock"></view>
  <view class="unlock-panel" wx:if="{{showUnlock}}">
    <text class="unlock-title">🔓 解锁教材</text>
    <text class="unlock-desc">输入邀请码或付费解锁</text>

    <view class="code-section">
      <input class="code-input" placeholder="输入邀请码" 
        maxlength="8" value="{{inviteCode}}" 
        bindinput="onCodeInput" />
      <text class="error-text" wx:if="{{errorMsg}}">{{errorMsg}}</text>
      <button class="btn-code" bindtap="onSubmitCode" disabled="{{loading}}">
        {{loading ? '验证中...' : '验证邀请码'}}
      </button>
    </view>

    <view class="divider">
      <text class="divider-line"></text>
      <text class="divider-text">或</text>
      <text class="divider-line"></text>
    </view>

    <view class="pay-section" bindtap="onPayUnlock">
      <text class="pay-icon">💳</text>
      <view class="pay-info">
        <text class="pay-title">付费解锁</text>
        <text class="pay-desc">即将开放，敬请期待</text>
      </view>
      <text class="pay-arrow">›</text>
    </view>

    <text class="close-btn" bindtap="onCloseUnlock">取消</text>
  </view>
</view>
