.page-wrap {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header {
  display: flex; align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #5B8DEF, #7C6FF7);
  padding: 20rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.header-info { flex: 1; min-width: 0; }
.header-title { font-size: 30rpx; font-weight: 700; color: #fff; display: block; }
.header-unit { font-size: 22rpx; color: rgba(255,255,255,0.7); display: block; }

.header-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.speed-btn, .play-all-btn, .cn-toggle-btn {
  font-size: 30rpx; color: #fff; background: rgba(255,255,255,0.2);
  padding: 14rpx 28rpx; border-radius: 28rpx;
  min-width: 80rpx;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cn-toggle-btn {
  font-weight: 700;
}
.speed-btn.slow {
  background: #E67E22;
  font-weight: 700;
}
.speed-btn.fast {
  background: rgba(255,255,255,0.2);
}

/* 课文区 */
.passage {
  padding: 24rpx;
}

.paragraph {
  background: #fff; border-radius: 20rpx;
  padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.sentence-wrap {
  margin-bottom: 4rpx;
  position: relative;
}

.sentence-row {
  display: flex; align-items: flex-start;
  padding: 10rpx 8rpx;
  border-radius: 10rpx;
  transition: all 0.15s;
  cursor: pointer;
}

.sentence-row.playing {
  background: #FFF3E0;
  border-left: 6rpx solid #E67E22;
  padding-left: 2rpx;
}

.sentence-row.playing .sentence-en {
  color: #E67E22;
  font-weight: 700;
}

.play-icon {
  font-size: 24rpx; color: #999;
  margin-right: 12rpx; margin-top: 6rpx; flex-shrink: 0;
}

.sentence-row.playing .play-icon {
  color: #E67E22;
}

.sentence-en {
  font-size: 30rpx; line-height: 1.8; color: #333;
  display: inline;
}

/* ===== 生词高亮 ===== */
.vocab-word {
  padding: 2rpx 4rpx;
  border-radius: 4rpx;
  cursor: pointer;
  display: inline;
}

/* 重点词 → 绿底 + 粗体 */
.vocab-word.key-word {
  font-weight: 700;
  background: #E8F5E9;
}

/* 非重点词 → 黄底（参考词） */
.vocab-word:not(.key-word) {
  background: #FFF8E1;
}

/* ===== 翻译下方单词卡片 ===== */
.word-cards {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 12rpx 0 4rpx 44rpx;
}

.word-card {
  width: 100%;
  background: #E3F2FD;
  border-radius: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.word-card.key-card {
  background: #E8F5E9;
}

.card-row1 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.card-word {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C3E50;
}
.card-play {
  font-size: 24rpx;
  flex-shrink: 0;
}
.card-rating {
  font-size: 20rpx;
  color: #F39C12;
  background: #FFF8E1;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
}
.card-phonetic {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.card-meaning {
  display: block;
  font-size: 26rpx;
  color: #E67E22;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 展开按钮 */
.card-expand-btn {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5B8DEF;
  text-align: center;
}
.card-extras {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #E8E8E8;
}
.extra-item {
  margin-bottom: 6rpx;
}
.extra-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #7C6FF7;
  display: block;
  margin-bottom: 2rpx;
}
.extra-text {
  font-size: 22rpx;
  color: #555;
  display: block;
}
.extra-cn {
  font-size: 20rpx;
  color: #999;
  display: block;
}

/* 句子中文 */
.sentence-cn {
  display: block; font-size: 26rpx; color: #999;
  line-height: 1.6; margin: 0 0 6rpx 44rpx;
}

/* 底部进度条 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(10px);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  transition: all 0.3s;
}
.footer-bar.active {
  background: rgba(255,255,255,0.98);
}
.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.progress-track {
  flex: 1;
  height: 6rpx;
  background: #E8E8E8;
  border-radius: 3rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B8DEF, #E67E22);
  border-radius: 3rpx;
  transition: width 0.3s;
}
.time-label {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}
