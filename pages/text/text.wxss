.page-wrap {
  background: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header {
  display: flex; align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #5B8DEF, #7C6FF7);
  padding: 24rpx 24rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.header-info { text-align: center; }
.header-title { font-size: 30rpx; font-weight: 700; color: #fff; display: block; }
.header-unit { font-size: 22rpx; color: rgba(255,255,255,0.7); display: block; }

.speed-btn, .play-all-btn, .cn-toggle-btn {
  font-size: 26rpx; color: #fff; background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx; border-radius: 24rpx; flex-shrink: 0;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cn-toggle-btn {
  min-width: 56rpx;
  font-weight: 700;
}
.speed-btn.slow {
  background: #E67E22;
  font-weight: 700;
}
.speed-btn.fast {
  background: rgba(255,255,255,0.2);
}

/* 课文区 */
.passage {
  padding: 24rpx;
}

.paragraph {
  background: #fff; border-radius: 20rpx;
  padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.sentence-wrap {
  margin-bottom: 4rpx;
  position: relative;
}

.sentence-row {
  display: flex; align-items: flex-start;
  padding: 10rpx 8rpx;
  border-radius: 10rpx;
  transition: all 0.15s;
  cursor: pointer;
}

.sentence-row.playing {
  background: #FFF3E0;
  border-left: 6rpx solid #E67E22;
  padding-left: 2rpx;
}

.sentence-row.playing .sentence-en {
  color: #E67E22;
  font-weight: 700;
}

.play-icon {
  font-size: 24rpx; color: #999;
  margin-right: 12rpx; margin-top: 6rpx; flex-shrink: 0;
}

.sentence-row.playing .play-icon {
  color: #E67E22;
}

.sentence-en {
  font-size: 30rpx; line-height: 1.8; color: #333;
}

/* ===== 重点词高亮（Kindle 淡黄荧光笔风格） ===== */
.vocab-word {
  background: #FFF8E1;
  padding: 2rpx 4rpx;
  border-radius: 4rpx;
  cursor: pointer;
  display: inline;
}

/* ===== 行内卡片 ===== */
.inline-card {
  display: none;
  margin: 8rpx 0 8rpx 44rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #F5F0FF, #EDE7F6);
  border-radius: 16rpx;
  border-left: 6rpx solid #7C6FF7;
  box-shadow: 0 4rpx 16rpx rgba(124,111,247,0.12);
  animation: cardSlideIn 0.2s ease-out;
}
.inline-card.show {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.card-word {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E50;
}
.card-phonetic {
  font-size: 24rpx;
  color: #aaa;
}
.card-meaning {
  font-size: 28rpx;
  color: #E67E22;
  font-weight: 600;
}

@keyframes cardSlideIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 句子中文 */
.sentence-cn {
  display: block; font-size: 26rpx; color: #999;
  line-height: 1.6; margin: 0 0 6rpx 44rpx;
}

/* 底部进度条 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(10px);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  transition: all 0.3s;
}
.footer-bar.active {
  background: rgba(255,255,255,0.98);
}
.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.progress-track {
  flex: 1;
  height: 6rpx;
  background: #E8E8E8;
  border-radius: 3rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B8DEF, #E67E22);
  border-radius: 3rpx;
  transition: width 0.3s;
}
.time-label {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}
