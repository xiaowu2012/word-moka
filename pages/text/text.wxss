/* 课文阅读页 - Duolingo 风格 */
.page-wrap {
  background: #FFFFFF;
  min-height: 100vh;
}

/* 顶部 */
.header {
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 2rpx solid #F0F0F0;
}
.header-info { text-align: center; }
.header-title { font-size: 28rpx; font-weight: 600; color: #4B4B4B; display: block; }
.header-unit { font-size: 22rpx; color: #bbb; display: block; margin-top: 2rpx; }

.play-all-btn, .cn-toggle-btn {
  font-size: 24rpx; color: #fff; background: #58CC02;
  padding: 8rpx 18rpx; border-radius: 16rpx; flex-shrink: 0;
  line-height: 1.3; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 4rpx rgba(88, 204, 2, 0.3);
}
.cn-toggle-btn { 
  min-width: 48rpx; font-weight: 700; 
  background: #E8E8E8; color: #888;
  box-shadow: none;
}
.cn-toggle-btn.active { background: #58CC02; color: #fff; box-shadow: 0 2rpx 4rpx rgba(88, 204, 2, 0.3); }

.passage-scroll {
  padding: 20rpx 24rpx;
}

.paragraph {
  background: #fff;
  padding: 12rpx 0;
  margin-bottom: 8rpx;
}

.sentence-row {
  display: flex; align-items: flex-start;
  padding: 14rpx 16rpx; border-radius: 14rpx;
  transition: all 0.2s;
  margin: 0 -8rpx;
}

.sentence-row.playing {
  background: #E5F5D9;
  box-shadow: 0 0 0 2rpx #58CC02;
}

.play-icon {
  font-size: 22rpx; color: #58CC02;
  margin-right: 12rpx; margin-top: 4rpx; flex-shrink: 0;
}

.sentence-row.playing .play-icon {
  color: #4B4B4B;
}

.sentence-en {
  font-size: 32rpx; line-height: 1.8; color: #4B4B4B;
}

.sentence-row.playing .sentence-en {
  font-weight: 700;
  color: #2B6B00;
}

.sentence-cn {
  display: block; font-size: 26rpx; color: #aaa;
  line-height: 1.5; margin: 4rpx 0 8rpx 50rpx;
}

.vocab-word {
  color: #1CB0F6; font-weight: 600;
  border-bottom: 3rpx solid #1CB0F6; padding-bottom: 2rpx;
}

/* 操作按钮 */
.action-bar {
  display: flex; gap: 12rpx;
  margin: 12rpx 0 8rpx 50rpx;
}
.action-btn {
  font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 16rpx;
  background: #F0F0F0; color: #888;
}
.action-btn.primary {
  background: #58CC02; color: #fff;
  box-shadow: 0 2rpx 4rpx rgba(88, 204, 2, 0.3);
}
.action-btn:active { opacity: 0.8; }

/* 底部单词卡片 */
.word-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.2); z-index: 99;
}
.word-card {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 100;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.1);
}
.wc-word { font-size: 40rpx; font-weight: 700; color: #4B4B4B; display: block; }
.wc-phonetic { font-size: 26rpx; color: #bbb; display: block; margin: 6rpx 0 16rpx; }
.wc-meaning { font-size: 32rpx; color: #E67E22; display: block; margin-bottom: 28rpx; }
.wc-close {
  display: block; width: 100%; text-align: center;
  background: #E8E8E8; color: #888;
  padding: 18rpx 0; border-radius: 16rpx;
  font-size: 28rpx;
}
