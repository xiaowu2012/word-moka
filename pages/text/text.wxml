<!-- 课文阅读页 -->
<view class="page-wrap">
  <!-- 固定顶部 -->
  <view class="header">
    <text class="back-btn" bindtap="onBack">‹</text>
    <view class="header-info">
      <text class="header-title">{{title}}</text>
      <text class="header-unit">{{unitId}}</text>
    </view>
    <text class="play-all-btn" bindtap="onTogglePlayAll">
      {{playAllMode ? '■ 停止' : '▶ 全文'}}
    </text>
  </view>

  <!-- 滚动课文区 -->
  <scroll-view class="passage-scroll" scroll-y>
    <view class="passage">
      <view class="paragraph" wx:for="{{paragraphs}}" wx:for-index="pidx" wx:key="pidx">
        <view wx:for="{{item.sentences}}" wx:key="gidx">
          <view class="sentence-row {{playingIdx === item.gidx ? 'playing' : ''}}"
                bindtap="onPlaySentence" data-idx="{{item.gidx}}">
            <text class="play-icon">{{playingIdx === item.gidx ? '🔊' : '▶'}}</text>
            <text class="sentence-en">
              <text wx:for="{{item.tokens}}" wx:key="*this">
                <text wx:if="{{item.isVocab}}" class="vocab-word"
                      bindtap="onTapWord" data-word="{{item.wordKey}}">{{item.text}} </text>
                <text wx:else>{{item.text}} </text>
              </text>
            </text>
          </view>
          <text class="sentence-cn">{{item.cn}}</text>
          <view class="action-bar" wx:if="{{showActions && actionSentenceIdx === item.gidx}}">
            <text class="action-btn" bindtap="onReplay">🔁 再读一遍</text>
            <text class="action-btn primary" bindtap="onContinueReading">➡ 往后跟读</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 重点词弹窗 -->
  <view class="word-mask" wx:if="{{showWordCard}}" bindtap="onCloseWordCard"></view>
  <view class="word-card" wx:if="{{showWordCard}}">
    <text class="wc-word">{{selectedWord.word}}</text>
    <text class="wc-phonetic">{{selectedWord.phonetic}}</text>
    <text class="wc-meaning">{{selectedWord.cnMeaning}}</text>
    <text class="wc-close" bindtap="onCloseWordCard">关闭</text>
  </view>
</view>
