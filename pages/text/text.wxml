<!-- 课文阅读页 - 单音频 + 时间戳高亮 + 慢/快切换 -->
<view class="page-wrap">
  <view class="header">
    <view class="header-info">
      <text class="header-title">{{title}}</text>
      <text class="header-unit">{{unitId}} · {{isSlow ? '慢速' : '常速'}}</text>
    </view>
    <view class="speed-btn {{isSlow ? 'slow' : 'fast'}}" bindtap="onToggleSpeed">
      <text>{{isSlow ? '慢' : '快'}}</text>
    </view>
    <view class="play-all-btn" bindtap="onTogglePlayAll">
      <text>{{isPlaying ? '⏸' : '▶'}}</text>
    </view>
    <view class="cn-toggle-btn" bindtap="onToggleCn">
      <text>{{showCn ? '中' : 'EN'}}</text>
    </view>
  </view>

  <view class="passage">
    <view class="paragraph" wx:for="{{paragraphs}}" wx:for-index="pidx" wx:key="pidx">
      <view class="sentence-wrap"
            wx:for="{{item.sentenceIndices}}"
            wx:for-index="sidx" wx:key="sidx">
        <view class="sentence-row {{playingSentenceIdx === sentences[item].index ? 'playing' : ''}}"
              id="sentence-{{sentences[item].index}}"
              data-idx="{{sentences[item].index}}"
              bindtap="onPlaySentence">
          <text class="play-icon">{{playingSentenceIdx === sentences[item].index ? '🔊' : '▶'}}</text>
          <text class="sentence-en">{{sentences[item].en}}</text>
        </view>
        <text class="sentence-cn" wx:if="{{showCn}}">{{sentences[item].cn}}</text>
      </view>
    </view>
  </view>

  <!-- 底部进度条 -->
  <view class="footer-bar {{isPlaying ? 'active' : ''}}">
    <view class="progress-row">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{playingSentenceIdx >= 0 ? (sentences[playingSentenceIdx].end / audioDuration * 100) : 0}}%"></view>
      </view>
      <view class="time-label">{{progressTime}}s / {{totalTime}}s</view>
    </view>
  </view>

  <!-- 重点词弹窗 -->
  <view class="word-mask" wx:if="{{showWordCard}}" bindtap="onCloseWordCard"></view>
  <view class="word-card" wx:if="{{showWordCard}}">
    <text class="wc-word">{{selectedWord.word}}</text>
    <text class="wc-phonetic">{{selectedWord.phonetic}}</text>
    <text class="wc-meaning">{{selectedWord.cnMeaning}}</text>
    <text class="wc-close" bindtap="onCloseWordCard">关闭</text>
  </view>
</view>
