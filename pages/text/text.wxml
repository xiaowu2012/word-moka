<!-- 课文阅读页 - 翻译下方显示单词卡片 -->
<view class="page-wrap">
  <view class="header">
    <view class="header-info">
      <text class="header-title">{{title}}</text>
      <text class="header-unit">{{unitId}} · {{isSlow ? '慢速' : '常速'}}</text>
    </view>
    <view class="header-actions">
      <view class="speed-btn {{isSlow ? 'slow' : 'fast'}}" bindtap="onToggleSpeed">
        <text>{{isSlow ? '慢' : '快'}}</text>
      </view>
      <view class="cn-toggle-btn" bindtap="onToggleCn">
        <text>{{showCn ? '中' : 'EN'}}</text>
      </view>
      <view class="play-all-btn" bindtap="onTogglePlayAll">
        <text>{{isPlaying ? '⏸' : '▶'}}</text>
      </view>
    </view>
  </view>

  <view class="passage">
    <view class="paragraph" wx:for="{{paragraphs}}" wx:for-index="pidx" wx:key="pidx">
      <view class="sentence-wrap"
            wx:for="{{item.sentenceIndices}}"
            wx:for-index="sidx" wx:key="sidx">
        <view class="sentence-row {{playingSentenceIdx === sentences[item].index ? 'playing' : ''}}"
              id="sentence-{{sentences[item].index}}"
              data-idx="{{sentences[item].index}}"
              bindtap="onPlaySentence">
          <text class="play-icon">{{playingSentenceIdx === sentences[item].index ? '🔊' : '▶'}}</text>
          <view class="sentence-en">
            <block wx:for="{{sentenceTokens[item]}}" wx:for-index="tidx" wx:key="tidx">
              <text wx:if="{{item.isVocab}}" class="vocab-word {{item.isKey ? 'key-word' : ''}}" data-word="{{item.wordKey}}">{{item.text}} </text>
              <text wx:else>{{item.text}} </text>
            </block>
          </view>
        </view>
        <text class="sentence-cn" wx:if="{{showCn}}">{{sentences[item].cn}}</text>

        <!-- 单词卡片区 -->
        <view class="word-cards" wx:if="{{showCn && wordCards[item] && wordCards[item].length > 0}}">
          <view class="word-card {{wcard.key ? 'key-card' : ''}}"
                wx:for="{{wordCards[item]}}"
                wx:for-index="cidx" wx:key="cidx"
                wx:for-item="wcard"
                data-word="{{wcard.word}}"
                catchtap="onPlayWord">
            <!-- 第一行: 单词 + 🔊 + ⭐ -->
            <view class="card-row1">
              <text class="card-word">{{wcard.word}}</text>
              <text class="card-play">🔊</text>
              <text class="card-rating" wx:if="{{wcard.importance}}">⭐{{wcard.importance}}</text>
            </view>
            <!-- 音标 + 中文 -->
            <text class="card-phonetic" wx:if="{{wcard.ph}}">{{wcard.ph}}</text>
            <text class="card-meaning">{{wcard.cn}}</text>

            <!-- 重点词额外信息: 例句/考点/词源（直接显示，无需展开）-->
            <view wx:if="{{wcard.key}}" class="card-extras">
              <view wx:if="{{wcard.example}}" class="extra-item">
                <text class="extra-label">例句</text>
                <text class="extra-text">{{wcard.example}}</text>
                <text class="extra-cn" wx:if="{{wcard.exampleCn}}">{{wcard.exampleCn}}</text>
              </view>
              <view wx:if="{{wcard.tip}}" class="extra-item">
                <text class="extra-label">考点</text>
                <text class="extra-text">{{wcard.tip}}</text>
              </view>
              <view wx:if="{{wcard.etymology}}" class="extra-item">
                <text class="extra-label">词源</text>
                <text class="extra-text">{{wcard.etymology}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部进度条 -->
  <view class="footer-bar {{isPlaying ? 'active' : ''}}">
    <view class="progress-row">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{playingSentenceIdx >= 0 ? (sentences[playingSentenceIdx].end / audioDuration * 100) : 0}}%"></view>
      </view>
      <view class="time-label">{{progressTime}} / {{totalTime}}</view>
    </view>
  </view>
</view>
