/* 全局样式 - Duolingo 风格 */
page {
  background-color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #4B4B4B;
  box-sizing: border-box;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  margin: 0 24rpx;
  padding: 28rpx;
}

/* 按钮基础 */
.btn-primary {
  background: #58CC02;
  color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(88, 204, 2, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag-blue {
  background: #DDF4FF;
  color: #1CB0F6;
}

.tag-orange {
  background: #FFF3E8;
  color: #E67E22;
}

.tag-green {
  background: #E5F5D9;
  color: #58CC02;
}
